import * as E from './engine.js';
const KEY='tno-demo-v1',PUB='tno-public-v1';
let s;try{s=JSON.parse(localStorage.getItem(KEY));if(s?.version!==1)s=null;}catch{}s??=E.initial();
let view='welcome',page='overview',group=0,playerId=1,roleVisible=false,privateRoles=false,guide=-1,holdTimer,toastTimer;
const $=id=>document.getElementById(id),esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const phase=()=>s.phases[s.phase],person=()=>E.getPlayer(s,playerId),time=n=>`${String(Math.floor(Math.max(0,n)/60)).padStart(2,'0')}:${String(Math.floor(Math.max(0,n)%60)).padStart(2,'0')}`;
function save(){try{localStorage.setItem(KEY,JSON.stringify(s));localStorage.setItem(PUB,JSON.stringify(E.publicData(s)));}catch{toast('Device storage is unavailable. Keep this tab open; progress may not survive refresh.');}}
function toast(t){$('toast').textContent=t;$('toast').style.display='block';clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').style.display='none',4200);}
function action(a,txt,cls='',attrs=''){return `<button class="${cls}" data-action="${a}" ${attrs}>${txt}</button>`;}
function pill(t,c=''){return `<span class="pill ${c}">${esc(t)}</span>`;}
function brand(){return `<div class="brand"><div class="brand-mark"><span>24</span></div><div class="brand-name"><small>2427 · BIGGIN HILL</small>Trust No One</div></div>`;}
function options(players,selected){return players.map(p=>`<option value="${p.id}" ${Number(selected)===p.id?'selected':''}>${esc(p.name)}</option>`).join('');}
function heading(k,title,sub,buttons=''){return `<div class="page-heading"><div><div class="eyebrow">${k}</div><h1 style="margin-top:9px">${title}</h1><p class="subtitle">${sub}</p></div><div class="btns">${buttons}</div></div>`;}
function panel(title,body,extra='',cls=''){return `<section class="panel ${cls}"><div class="panel-head"><h3>${title}</h3>${extra}</div><div class="panel-body">${body}</div></section>`;}
function footer(){return `<footer class="footer"><span>2427 (Biggin Hill) · Halloween rehearsal<br>Independent game concept. Not affiliated with the BBC or The Traitors.</span><span>Local demo · No Flight Points integration<br><a href="guide.html" target="_blank">Guide & source code ↗</a></span></footer>`;}
function welcome(){return `<div class="welcome"><header class="welcome-nav">${brand()}<div class="row">${pill('DEMONSTRATION BUILD','amber')}<span class="tiny muted">An evening of trust, teamwork & deception.</span></div></header><main class="welcome-main"><div><div class="eyebrow">Five groups. Ten traitors. Trust carefully.</div><h1>Keep your<br>friends close.<br><em>Your secrets<br>closer.</em></h1><p class="intro">An after-dark challenge for 2427. Solve the missions, read the room and discover who is hiding in plain sight.</p><div class="btns">${action('start','Enter the demonstration ↗','gold')}${action('guide','Show staff the demo','ghost')}</div><div class="crest"><div class="badge-circle">2427</div><span>2427 (Biggin Hill) RAF Air Cadets<br><span class="tiny muted">Authorised badge can be added later</span></span></div></div><div class="entry-panel"><div class="row between"><span class="eyebrow">Your evening starts here</span><span class="icon">◇</span></div><h2 style="margin-top:17px">Take your place.</h2><p class="subtitle">Try joining as a fictional cadet. Codes below are for this device’s demonstration only.</p><form id="join-form" class="stack" style="margin-top:23px"><label class="field">Event code<input id="event-code" value="2427-DEMO" autocomplete="off" required></label><label class="field">Individual joining code<input id="join-code" value="P01-DEMO" autocomplete="off" required></label><button class="gold full" type="submit">Join the demo event →</button></form><p class="tiny muted" style="margin-top:12px">Example codes: P01-DEMO to P50-DEMO. Shared event code alone is not sufficient.</p><div class="divider"></div><div class="row between"><div><h3>Running the evening?</h3><p class="tiny muted">Explore the organiser controls.</p></div>${action('start','Organiser demo ↗','small')}</div><div class="divider"></div><button disabled class="full">Connected Test Mode · unavailable</button><p class="tiny muted" style="margin-top:10px">No shared backend is configured. Separate phones will not join the same game. <a href="guide.html#backend" target="_blank">What needs setting up?</a></p></div></main><section class="welcome-bottom"><div><div class="number">01 / Work together</div><h3>Win the physical missions.</h3><p>Every cadet helps their group earn points, even after elimination. Keep phone time short.</p></div><div><div class="number">02 / Watch carefully</div><h3>Find the Traitors among you.</h3><p>Discuss what happens in the game. Keep accusations kind, respectful and about game actions.</p></div><div><div class="number">03 / Reveal the truth</div><h3>Make it to the final round table.</h3><p>Catch all your group’s Traitors for a Faithful victory. One surviving Traitor is enough to win.</p></div></section><div style="padding:0 6% 26px">${footer()}</div></div>`;}
const navs=[['overview','◈','Control room'],['groups','♜','Groups & players'],['missions','◇','Missions'],['voting','◎','Round table'],['night','☾','Night operations'],['schedule','◷','Run of show'],['results','✧','Final results'],['log','≡','Event log'],['settings','⚙','Event settings']];
function shell(content){const who=view==='host'?'Host':view==='nco'?'Group NCO':'Cadet';return `<div class="app-layout"><aside class="sidebar">${brand()}<div class="edition"><span class="dot"></span> &nbsp; Halloween · rehearsal edition</div><div class="nav-label">${view==='cadet'?'YOUR EVENING':'EVENT MANAGEMENT'}</div><nav class="nav">${view==='cadet'?action('page','<span class="icon">◇</span> My dashboard','active','data-page="overview"'):navs.filter(n=>view!=='nco'||['groups','missions','voting','night','log'].includes(n[0])).map(n=>action('page',`<span class="icon">${n[1]}</span>${n[2]}`,page===n[0]?'active':'',`data-page="${n[0]}"`)).join('')}</nav><div class="nav-label">PRESENTATION</div><nav class="nav">${action('projector','<span class="icon">▱</span> Public display ↗')}${action('guide','<span class="icon">▷</span> Guided walkthrough')}${action('welcome','<span class="icon">⌂</span> Welcome & joining')}</nav><div class="sidebar-foot"><div class="badge-placeholder"><div class="badge-circle">24</div><div>2427 (Biggin Hill)<br>Authorised badge placeholder</div></div><a class="tiny" href="guide.html" target="_blank">Demo guide & source ↗</a></div></aside><div><header class="topbar"><span class="tiny muted breadcrumb">2427: Trust No One &nbsp; / &nbsp; ${who} workspace</span><div class="row"><span class="tiny muted">Preview as</span><select id="view-switch" aria-label="Preview role"><option value="host" ${view==='host'?'selected':''}>Host</option><option value="nco" ${view==='nco'?'selected':''}>Group NCO</option><option value="faithful" ${view==='cadet'&&person().role!=='Traitor'&&person().status==='Active'?'selected':''}>Faithful cadet</option><option value="traitor" ${view==='cadet'&&person().role==='Traitor'&&person().status==='Active'?'selected':''}>Traitor cadet</option><option value="eliminated" ${view==='cadet'&&person().status!=='Active'?'selected':''}>Eliminated cadet</option></select></div>${pill('DEVICE LOCAL','green')}</header><div class="demo-strip"><span><span class="dot"></span> &nbsp; Demo mode: simulated players</span><span>Saved on this device · Separate phones do not sync</span></div><main class="workspace">${guide>=0?guideBar():''}${content}${footer()}</main></div></div>`;}
function phaseCard(){const p=phase();return `<section class="panel phase-card"><div class="phase-art">${p.type==='murder'?'☾':p.type==='vote'?'◎':'◇'}</div><div class="row between"><span class="eyebrow">Current phase · ${String(s.phase+1).padStart(2,'0')} / 13</span>${pill(s.running?'IN PROGRESS':'READY / PAUSED',s.running?'green':'amber')}</div><h2>${esc(p.name)}</h2><p class="subtitle">${p.type==='mission'?'Phones away. Your next clue is out there.':p.type==='vote'?'Give everyone a voice. Keep accusations within the game.':'Keep your group together. The host controls what happens next.'}</p><div class="row between" style="margin-top:24px"><div><div class="timer" data-timer>${time(s.remaining)}</div><p class="tiny muted" style="margin-top:9px">remaining · timers never reveal secrets</p></div><div class="right"><span class="tiny muted">SCHEDULED</span><p class="serif" style="font-size:26px">${p.time}</p></div></div><div class="progress" style="margin-top:22px"><span style="width:${Math.min(100,Math.max(0,s.remaining/(p.mins*60)*100))}%"></span></div><div class="row between phase-footer"><div class="btns">${action('timer',s.running?'Ⅱ Pause':'▷ Start timer','gold')}${action('extend','+ 1 min','ghost')}</div>${action('advance','Next phase →','ghost',''+(s.phase===12?'disabled':''))}</div></section>`;}
function stats(){let active=s.players.filter(p=>p.status==='Active').length,connected=s.players.filter(p=>p.connected).length,pending=Object.values(s.murders).filter(m=>m.confirmed&&!m.published).length;return `<div class="stats"><div class="stat"><label>Players in the room</label><strong>${s.players.length}<span class="muted" style="font-size:16px"> / ${s.players.length}</span></strong><span class="tiny">${connected} simulated connections</span></div><div class="stat"><label>Active in the game</label><strong>${active}</strong><span class="tiny">${s.players.length-active} still helping with missions</span></div><div class="stat"><label>Groups in play</label><strong>${s.groups.length}</strong><span class="tiny">${s.groups.filter(g=>g.done).length} deduction games finished</span></div><div class="stat"><label>Awaiting your attention</label><strong>${pending+s.helps.filter(h=>!h.done).length+s.players.length-connected}</strong><span class="tiny">Decisions, help & signal loss</span></div></div>`;}
function groupRows(){return `<section class="panel"><div class="panel-head"><h3>The five circles <span class="muted tiny">/ ${s.groups.length} groups</span></h3>${action('page','Manage groups ↗','small ghost','data-page="groups"')}</div><div class="group-list"><div class="group-row table-labels"><span></span><span>Group</span><span>Active</span><span>Points</span><span>Status</span><span></span></div>${s.groups.map((g,i)=>`<div class="group-row"><div class="group-icon">${['♜','◇','✧','♧','☾'][i]}</div><div><h3 style="font-size:12px">${esc(g.name)}</h3><span class="tiny muted">Circle ${String(i+1).padStart(2,'0')}</span></div><span class="muted">${E.active(s,i).length} / ${s.players.filter(p=>p.group===i).length}</span><span class="score">${g.score}</span>${pill(g.done?'SOLVED':'READY',g.done?'amber':'green')}${action('group','›','small ghost',`data-group="${i}" aria-label="Manage ${esc(g.name)}"`)}</div>`).join('')}</div></section>`;}
function timeline(){return `<section class="panel"><div class="panel-head"><h3>Tonight’s run of show</h3>${action('page','View all ↗','small ghost','data-page="schedule"')}</div><div class="timeline">${s.phases.slice(Math.max(0,s.phase-1),Math.max(0,s.phase-1)+5).map((p,i)=>`<div class="timeline-item ${p===phase()?'current':''}"><time>${p.time}</time><span class="marker"></span><div><h4>${esc(p.name)}</h4><small>${p.mins} minutes ${p===phase()?'· current phase':''}</small></div></div>`).join('')}</div><div style="padding:0 20px 18px"><p class="tiny muted">21:05 finish · 21:10 clear up · 21:15 parade</p></div></section>`;}
function overview(){return heading('THE HOST WORKSPACE','A little trust. A lot of secrets.','Your evening at a glance. Keep the missions moving and the mystery alive.',action('projector','Open public display ↗','ghost'))+stats()+`<div class="dashboard-grid"><div class="stack">${phaseCard()}${groupRows()}${panel('Simulation desk',`<p class="tiny muted" style="margin-bottom:14px">Rehearse busy moments without needing 50 phones.</p><div class="btns">${action('sim-votes','Simulate votes')}${action('sim-murder','Simulate murder choices')}${action('disconnect','Simulate signal loss')}</div>`)}${s.helps.some(h=>!h.done)?panel('Help requests',s.helps.filter(h=>!h.done).map(h=>`<div class="row between" style="margin:9px 0"><span>${esc(E.getPlayer(s,h.id).name)} · ${esc(s.groups[E.getPlayer(s,h.id).group].name)}</span>${action('help-done','Acknowledge','small',`data-id="${h.id}"`)}</div>`).join('')):''}</div><div class="aside-grid"><div>${timeline()}</div><div class="stack">${panel('Public announcement',`<div class="announcement"><span class="eyebrow">LATEST MESSAGE</span><p>${esc(s.announcements[0]?.text)}</p><span class="tiny muted">Visible to all cadets and the public display</span></div><form id="announce-form" class="stack" style="margin-top:15px"><label class="field">New message<textarea id="announcement" maxlength="280" placeholder="A short message for everyone…" required></textarea></label><button type="submit" class="full">Publish announcement ↗</button></form>`)}${panel('Before the first secret',`<p class="tiny muted" style="margin-bottom:15px">${s.assigned?'Roles are assigned and saved. Cadets can reveal their own envelope.':'Check everyone is present, then close joining and release the roles.'}</p><div class="btns">${action('assign',s.assigned?'Roles released ✓':'Close joining & assign roles','gold',s.assigned?'disabled':'')}</div>`)}<div class="notice"><span class="eyebrow">A game, not a judgement</span><p style="margin-top:7px">Accusations are about game actions. Anyone can ask an NCO for help at any time.</p></div></div></div></div>`;}
function groupTabs(){return view==='nco'?`<div class="notice" style="margin-bottom:18px">Assigned group: ${esc(s.groups[group].name)}. This demonstration switches views locally; it is not authentication.</div>`:`<div class="tab-buttons">${s.groups.map(g=>action('select-group',g.name,g.id===group?'active':'',`data-group="${g.id}"`)).join('')}</div>`;}
function groups(){const g=s.groups[group],people=s.players.filter(p=>p.group===group);return heading('PEOPLE & PERMISSIONS','Every face has a story.','Fictional players only. Group NCO tools stay scoped to the selected circle.')+groupTabs()+`<div class="dashboard-grid"><div>${panel(`${esc(g.name)} · Circle ${group+1}`,`<div class="row between" style="margin-bottom:18px"><span class="tiny muted">${people.length} joined · ${E.active(s,group).length} active</span>${action('roles',privateRoles?'Hide roles':'Reveal organiser roles','small ghost')}</div><div class="player-list">${people.map(p=>`<div class="player"><span class="avatar">${String(p.id).padStart(2,'0')}</span><div class="info">${esc(p.name)}<small><span class="dot ${p.connected?'':'off'}"></span> ${p.connected?'Simulated online':'Disconnected'} · ${p.status}${p.shield?' · Shield':''}</small>${privateRoles?`<span class="roster-secret">${p.role??'Role not assigned'}</span>`:''}</div>${action('player-tools','•••','ghost',`data-id="${p.id}" aria-label="Manage ${p.name}"`)}</div>`).join('')}</div>`)}</div><div class="stack">${panel('Mission team score',`<div class="row between"><span class="timer">${g.score}</span><span class="tiny muted">points earned<br>independent of role winners</span></div><form id="score-form" class="stack" style="margin-top:20px"><label class="field">Points adjustment (+ or −)<input id="score-delta" type="number" min="-999" max="999" value="25" required></label><label class="field">NCO’s reason<input id="score-reason" maxlength="160" placeholder="e.g. Archive code verified" required></label><button class="gold" type="submit">Confirm & log points</button></form>`)}${panel('Group NCO workspace',`<p class="tiny muted" style="margin-bottom:15px">View only this group’s controls, monitor submitted votes and review private game messages.</p>${action('nco','Preview this group’s NCO','full')}`)}${panel('Group assistance',s.helps.filter(h=>!h.done&&E.getPlayer(s,h.id).group===group).map(h=>`<div class="row between"><span>${E.getPlayer(s,h.id).name}</span>${action('help-done','Acknowledge','small',`data-id="${h.id}"`)}</div>`).join('')||'<p class="tiny muted">No open help requests in this group.</p>')}</div></div>`;}
function missions(){return heading('THE PHYSICAL CHALLENGES','More than a game of suspicion.','Every player contributes. Eliminated cadets stay on the mission team.')+`<div class="card-grid">${s.missions.map((m,i)=>`<section class="panel mission-card"><div class="row between"><span class="eyebrow">MISSION ${String(i+1).padStart(2,'0')}</span>${pill(`${m.points} PTS MAX`,'amber')}</div><div class="mission-number">${['◇','♜','⌁'][i]}</div><h2>${esc(m.title)}</h2><p>${esc(m.description)}</p><div class="btns">${action('mission-detail','Mission briefing','small',`data-index="${i}"`)}${view==='host'?action('mission-edit','Edit','small ghost',`data-index="${i}"`):''}</div></section>`).join('')}</div><div class="section-gap notice">Physical props and clue sheets must be prepared by the NCO team. These editable cards explain the demonstration activities; they do not verify physical completion. Record verified points in Groups & players.</div><div class="section-gap">${action('page','Confirm mission points →','gold','data-page="groups"')}</div>`;}
function voting(){const v=s.votes[E.voteKey(s,group)],people=E.active(s,group),round=phase().round??0;return heading('THE ROUND TABLE','Let the room decide.','One private vote per active player. No self voting. Choices can change until closure.')+groupTabs()+`<div class="dashboard-grid"><div class="stack">${panel(`${s.groups[group].name} · ${phase().type==='vote'?phase().name:'No round table in progress'}`,`<div class="notice">Accusations should concern actions within the game. Give everyone time to speak.</div><div class="row between" style="margin:24px 0"><div><span class="timer">${v?Object.keys(v.ballots).length:0}<span style="font-size:25px;color:var(--muted)"> / ${people.length}</span></span><p class="tiny muted" style="margin-top:10px">votes submitted ${v?.runoff?'· runoff':''}</p></div>${pill(v?.status?.toUpperCase()??'DISCUSSION','amber')}</div><div class="btns">${action('open-vote','Open voting','gold',phase().type!=='vote'||v||s.groups[group].done?'disabled':'')}${action('close-vote','Close voting','',v?.status!=='open'?'disabled':'')}${action('extend','Extend 1 min','ghost')}${action('sim-votes','Simulate votes','ghost',v?.status!=='open'?'disabled':'')}</div>${phase().type!=='vote'&&view==='host'?`<p class="tiny muted" style="margin-top:16px">Advance to a round table from the control room or run of show.</p>`:''}${v?.status==='tie'?`<div class="notice section-gap">Tied candidates: ${v.tied.map(id=>E.getPlayer(s,id).name).join(', ')}.<div class="btns" style="margin-top:12px">${v.runoff?action('random-tie','Host random draw','gold',view==='nco'?'disabled':''):action('runoff','Open one short runoff','gold')}</div></div>`:''}${v?.status==='closed'?`<div class="notice section-gap">${v.result?`${E.getPlayer(s,v.result).name} received the final result. ${v.revealed?'Published.':'Held privately until the host reveals it.'}`:'No votes were cast. No one is banished.'}<p class="tiny">${v.abstentions?.length??0} abstention(s) recorded.</p><div class="btns" style="margin-top:12px">${action('publish-banish','Publish banishment','danger',!v.result||v.revealed||view==='nco'?'disabled':'')}${action('reveal-role','Then reveal role','',!v.revealed||view==='nco'||s.lastReveal?.kind!=='Banished'||s.lastReveal.role?'disabled':'')}</div></div>`:''}`)}${panel('Submission register',`<div class="player-list">${people.map(p=>`<div class="player"><span class="avatar">${p.id}</span><div class="info">${p.name}<small>${v?.ballots[p.id]?'Submitted ✓':'Awaiting vote'}</small></div></div>`).join('')}</div><p class="tiny muted" style="margin-top:15px">No running tally shown here. Missing votes become abstentions on closure.</p>`)}</div><div>${panel('Record a vote on behalf of a cadet',`<form id="proxy-form" class="stack"><label class="field">Voter<select id="proxy-voter">${options(people)}</select></label><label class="field">Their chosen candidate<select id="proxy-target">${options(people.filter(p=>!v?.candidates||v.candidates.includes(p.id)))}</select></label><p class="tiny muted">Ask the cadet for their choice. Proxy submissions are recorded in the organiser log.</p><button type="submit" ${v?.status!=='open'?'disabled':''}>Record proxy vote</button></form>`)}<div class="notice section-gap">A disconnected player stays in the game. Extend the ballot or record their vote with permission. A tie gets one runoff, then a host-triggered random draw.</div></div></div>`;}
function night(){const slot=phase().slot??0,m=s.murders[E.murderKey(group,slot)],traitors=E.active(s,group).filter(p=>p.role==='Traitor'),targets=E.active(s,group).filter(p=>p.role==='Faithful');return heading('PRIVATE ORGANISER AREA','What happens after dark.','Outcomes remain private until the host explicitly publishes them.')+groupTabs()+`<div class="dashboard-grid"><div class="stack">${panel(`Opportunity ${slot+1} · ${slot===1?'Murder in plain sight':'Standard murder'}`,`<div class="notice danger">Private information. Authorised organisers can view all game messages. This is a local simulation, not secure connected play.</div><p class="subtitle">${slot===1?'Assign a physical objective during The Vault. Confirm success or failure before the next banishment.':'Traitors choose an active Faithful from their own group. Confirm the outcome, then release it when ready.'}</p><div class="section-gap">${m?`<h3>Proposed target: ${E.getPlayer(s,m.target)?.name??'None'}</h3><p class="subtitle">${m.confirmed?`${m.reason} · ${m.published?'published':'held privately'}`:'Awaiting NCO confirmation'}</p>${Object.entries(m.choices).map(([id,target])=>`<p class="tiny muted">${E.getPlayer(s,id).name} → ${E.getPlayer(s,target).name}</p>`).join('')}`:'<p class="muted">No target proposed yet.</p>'}</div><form id="murder-form" class="form-grid section-gap"><label class="field">Acting Traitor<select id="murder-actor">${options(traitors)}</select></label><label class="field">Eligible target<select id="murder-target">${options(targets,m?.target)}</select></label><button type="submit" ${!traitors.length||m?.confirmed?'disabled':''}>Record proposal</button></form><div class="btns section-gap">${action('confirm-murder',slot===1?'NCO: confirm success':'Confirm outcome','gold',!m||m.confirmed?'disabled':'')}${slot===1?action('fail-murder','NCO: mark failed','',!m||m.confirmed?'disabled':''):''}${action('publish-murder','Publish public reveal','danger',!m?.confirmed||m.published||view==='nco'?'disabled':'')}</div><p class="tiny muted" style="margin-top:15px">${s.settings.decisionMaker?'On disagreement, the lowest-numbered active Traitor is the designated decision maker.':'Unresolved disagreement blocks confirmation.'} One victim maximum. Shields block the attempt without choosing a replacement.</p>`)}${panel('Secret objective',`<form id="objective-form" class="stack"><label class="field">Instruction for active Traitors in ${s.groups[group].name}<textarea id="objective" maxlength="280" required>${esc(s.objectives[group]??'During The Vault, persuade your assigned target to say “trust no one”. Report completion to your NCO before the mission ends.')}</textarea></label><button type="submit">Send private objective</button></form>`)}${panel('Traitor communications',s.messages.filter(m=>m.group===group).slice(-8).map(m=>`<div class="chat-message"><small>${esc(m.from)} · ${esc(m.time)}</small><p>${esc(m.text)}</p></div>`).join('')||'<p class="tiny muted">No private messages yet.</p>')}</div><div class="stack">${panel('Resolution checklist',`<div class="stack"><p class="tiny muted">1. Assign the target and objective.<br>2. Check eligibility and any shield.<br>3. NCO confirms physical success or failure.<br>4. Keep the outcome private.<br>5. Host releases the public reveal.</p><div class="notice">A confirmed secret mission remains recorded if its acting Traitor is subsequently banished. If its target has already been eliminated, no replacement victim is selected.</div></div>`)}${panel('Protection rules',`<p class="tiny muted">Shields are ${s.settings.shields?'enabled':'disabled by default'}. When enabled, they protect against either murder opportunity when the outcome is confirmed. They never block banishment. Demo shields last for the event.</p>`)}</div></div>`;}
function schedule(){return heading('THE RUN OF SHOW','Leave time for the truth.','Editable timings. Keep the finale at 21:05, clear up at 21:10 and parade at 21:15.',action('late','Running late?','gold'))+`<div class="dashboard-grid">${panel('Evening timetable',`<form id="schedule-form"><div class="schedule-row muted"><span>START</span><span>PHASE</span><span>MINUTES</span></div>${s.phases.map((p,i)=>`<div class="schedule-row"><input aria-label="${esc(p.name)} start" type="time" id="start-${i}" value="${p.time}" required><div>${esc(p.name)} ${i===s.phase?pill('NOW','amber'):''}${view==='host'?`<br>${action('jump','Go to phase','small ghost',`data-index="${i}"`)}`:''}</div><input aria-label="${esc(p.name)} duration" type="number" id="mins-${i}" min="1" max="60" value="${p.mins}" required></div>`).join('')}<button type="submit" class="gold section-gap">Save timetable</button></form>`)}<div class="stack">${phaseCard()}<div class="notice">Times are the planned run sheet. Starting a demo timer begins a relative countdown. Reaching zero prompts the organiser; it never advances the phase or reveals a role.</div></div></div>`;}
function results(){return heading('THE FINAL REVEAL','Every secret has an ending.','Deduction winners and physical mission scores are separate achievements.',s.ended?'':action('finish','End game & reveal winners','gold',view!=='host'?'disabled':''))+(s.ended?`<div class="results-grid">${E.results(s).map(g=>`<section class="panel result"><span class="eyebrow">${esc(g.name)}</span><h2>${g.winner} win</h2><p>${g.score} mission points</p></section>`).join('')}</div><div class="notice section-gap">Highest-scoring mission team${s.groups.filter(g=>g.score===Math.max(...s.groups.map(x=>x.score))).length>1?'s (tied)':''}: ${s.groups.filter(g=>g.score===Math.max(...s.groups.map(x=>x.score))).map(g=>g.name).join(', ')}.</div><div class="section-gap">${panel('The people behind the secrets',`<div class="player-list">${s.players.map(p=>`<div class="player"><span class="avatar">${p.id}</span><div class="info">${p.name}<small>${s.groups[p.group].name} · ${p.status}</small></div>${pill(p.role,p.role==='Traitor'?'red':'green')}</div>`).join('')}</div>`)}</div>`):`<div class="panel empty"><div class="seal">?</div><h2>The truth is still sealed.</h2><p style="margin-top:13px">After the final banishment, the host can release the winners.<br>Any surviving Traitor wins their group’s deduction game.</p></div>`)+`<div class="section-gap">${panel('Published timeline',s.published.map(e=>`<div class="log-entry"><time>${e.time}</time><span>${esc(e.group)} · ${esc(e.name)} · ${e.kind}${e.role?' · '+e.role:''}</span></div>`).join('')||'<p class="tiny muted">No eliminations have been published.</p>')}</div>`;}
function logs(){let entries=view==='nco'?s.log.filter(e=>e.text.includes(s.groups[group].name)||s.players.filter(p=>p.group===group).some(p=>e.text.includes(p.name))):s.log;return heading('ORGANISER AUDIT','A record of the evening.','Manual actions and corrections are recorded on this device.')+panel('Latest first',entries.map(e=>`<div class="log-entry"><time>${e.time}</time><span>${esc(e.text)}</span></div>`).join('')||'<p class="muted">The log begins when you take your first action.</p>');}
function settings(){return heading('BEFORE THE EVENING','Set the ground rules.','These defaults describe a test event, ready for an NCO rehearsal.')+`<div class="dashboard-grid">${panel('Event configuration',`<form id="settings-form" class="stack"><div class="form-grid"><label class="field">Groups (1–5)<input type="number" id="group-count" min="1" max="5" value="${s.settings.groups}" ${s.assigned?'disabled':''}></label><label class="field">Players per group (4–12)<input type="number" id="group-size" min="4" max="12" value="${s.settings.size}" ${s.assigned?'disabled':''}></label><label class="field">Traitors per group (1–3)<input type="number" id="traitor-count" min="1" max="3" value="${s.settings.traitors}" ${s.assigned?'disabled':''}></label></div><p class="tiny muted">Roster size can change before roles are assigned. Three banishments and two murder opportunities are fixed for this first version.</p><label class="check"><input type="checkbox" id="shields" ${s.settings.shields?'checked':''}>Enable optional shields</label><label class="check"><input type="checkbox" id="chat" ${s.settings.chat?'checked':''}>Allow short free text Traitor messages</label><label class="check"><input type="checkbox" id="decision-maker" ${s.settings.decisionMaker?'checked':''}>Use lowest-numbered active Traitor for disagreements</label><label class="check"><input type="checkbox" id="sound" ${s.settings.sound?'checked':''}>Optional timer sound</label><button class="gold" type="submit">Save settings</button></form>`)}<div class="stack">${panel('Connected Test Mode',`<button disabled class="full">Backend not configured</button><p class="subtitle">This demo runs on one device. Roles are present in local demo state so the presenter can switch perspectives. It is not safe for genuine secret roles across players.</p><a href="guide.html#backend" target="_blank">Read connected setup & test requirements ↗</a>`)}${panel('Rehearsal data',`<p class="tiny muted" style="margin-bottom:15px">Reset creates a fresh fictional event. Delete removes this demo’s local saved state. Neither affects your other websites.</p><div class="btns">${action('reset','Reset demo','danger')}${action('delete','Delete saved data','ghost')}</div>`)}</div></div>`;}
function cadet(){const p=person(),g=s.groups[p.group],ph=phase(),v=s.votes[E.voteKey(s,p.group)],m=s.murders[E.murderKey(p.group,ph.slot??0)],isActive=p.status==='Active',partners=E.active(s,p.group).filter(x=>x.role==='Traitor'&&x.id!==p.id);return `<div class="cadet-wrap"><div class="row between" style="margin-bottom:17px"><span class="eyebrow">CIRCLE ${p.group+1} / ${esc(g.name)}</span>${pill(p.status,isActive?'green':'red')}</div><section class="panel"><div class="cadet-top"><div class="row between"><h2>${p.name}</h2><div class="group-icon">${String(p.id).padStart(2,'0')}</div></div><p class="tiny muted" style="margin-top:10px"><span class="dot ${p.connected?'':'off'}"></span> ${p.connected?'Local demo ready':'Simulated signal loss · actions unavailable'} · ${g.score} mission points</p></div><div class="panel-body"><div class="row between"><div><span class="eyebrow">RIGHT NOW</span><h2 style="margin-top:8px">${esc(ph.name)}</h2></div><span class="timer" style="font-size:35px" data-timer>${time(s.remaining)}</span></div>${!isActive?`<div class="notice section-gap">You are ${p.status.toLowerCase()}, but your evening continues. Help your team in every physical mission. Voting and secret actions are closed.${p.role==='Traitor'?' Keep your former partners’ identities secret.':''}</div>`:''}${!s.assigned?`<div class="envelope"><div><div class="seal">?</div><h2>Your place is ready.</h2><p class="subtitle">${s.joining?'Joining is open.':'Joining is closed.'} Wait for the host to release roles.</p></div></div>`:isActive?`<div class="envelope"><div>${roleVisible?`<span class="eyebrow">YOUR PRIVATE ROLE</span><div class="revealed-role">${p.role}</div><p class="tiny muted" style="margin:12px 0">${p.role==='Traitor'?'Keep your identity secret. Survive the final banishment.':'Work together to identify every Traitor in your group.'}</p>${p.role==='Traitor'?`<p class="tiny">Active partners: ${partners.map(x=>x.name).join(', ')||'None'}</p>`:''}${action('hide-role','Hide my role','small ghost')}`:`<div class="seal">24</div><h3>Your secret is sealed.</h3><p class="tiny muted" style="margin:10px 0 16px">Check that nobody is looking over your shoulder.</p><button class="hold gold" id="hold-role">Press & hold to reveal</button><p class="tiny muted" style="margin-top:10px">Hold for 0.7 seconds. Keyboard: hold Space or Enter.</p>`}</div></div>`:''}${ph.type==='mission'?`<div class="notice"><span class="eyebrow">PHONES AWAY</span><h3 style="margin:9px 0">Your team needs you out there.</h3><p>${esc(s.missions[ph.mission].instructions)}</p><p class="tiny" style="margin-top:9px">Your NCO confirms completion and awards points.</p></div>`:''}${ph.type==='vote'&&isActive?`<div class="section-gap"><h3>Your private vote</h3><p class="tiny muted" style="margin:9px 0">Choose one active player in ${g.name}. You can change your choice until voting closes.</p>${v?.status==='open'?`<div class="vote-options">${E.active(s,p.group).filter(t=>t.id!==p.id&&(!v.candidates||v.candidates.includes(t.id))).map(t=>action('cadet-vote',t.name,v.ballots[p.id]===t.id?'selected':'',`data-id="${t.id}" ${!p.connected?'disabled':''}`)).join('')}</div>${v.ballots[p.id]?`<div class="notice section-gap">Saved on this device: your vote for ${E.getPlayer(s,v.ballots[p.id]).name}. This is a simulated acknowledgement, not a server receipt.</div>`:''}`:`<div class="notice">${v?'Voting is closed. Wait for the host’s result reveal.':'Discussion is open. Wait for your NCO to open the ballot.'}</div>`}</div>`:''}${p.role==='Traitor'&&isActive&&roleVisible&&!s.ended?`<div class="section-gap">${panel('Private circle',`<p class="tiny muted">Authorised organisers can read game messages. Only active Traitors may use this area.</p>${s.objectives[p.group]?`<div class="notice section-gap">NCO objective: ${esc(s.objectives[p.group])}</div>`:''}${['murder','mission'].includes(ph.type)&&ph.slot!==undefined?`<form id="cadet-target-form" class="stack section-gap"><label class="field">${m?.target?'Agree with the target or suggest another':'Propose a target'}<select id="cadet-target">${options(E.active(s,p.group).filter(t=>t.role==='Faithful'),m?.target)}</select></label><button type="submit" ${m?.confirmed||!p.connected?'disabled':''}>Submit target choice</button></form>${ph.slot===1?action('report-objective','Report objective completed','full section-gap',!p.connected||!m?'disabled':''):''}`:'<p class="tiny muted" style="margin-top:12px">Target choices open during a murder opportunity or The Vault.</p>'}<div class="section-gap">${s.messages.filter(x=>x.group===p.group).slice(-5).map(x=>`<div class="chat-message"><small>${esc(x.from)}</small><p>${esc(x.text)}</p></div>`).join('')}</div><div class="btns">${['I agree','Suggest another target','Let’s wait for the NCO'].map(t=>action('preset',t,'small',`data-text="${esc(t)}" ${!p.connected?'disabled':''}`)).join('')}</div>${s.settings.chat?`<form id="chat-form" class="row section-gap"><input id="chat-text" aria-label="Private message" placeholder="Short game message…" maxlength="160" required><button type="submit" ${!p.connected?'disabled':''}>Send</button></form>`:''}`)}</div>`:''}<div class="announcement section-gap"><span class="eyebrow">FROM THE ORGANISERS</span><p>${esc(s.announcements[0]?.text)}</p></div>${s.lastReveal?`<div class="notice section-gap">Latest public result: ${esc(s.lastReveal.name)} · ${s.lastReveal.kind}${s.lastReveal.role?' · '+s.lastReveal.role:''}</div>`:''}${s.ended?`<div class="notice section-gap">${E.results(s).find(x=>x.id===p.group).winner} win in ${g.name}. Your mission team earned ${g.score} points.</div>`:''}<div class="btns section-gap">${action('help','Need help?','ghost')}${action('rules','Quick rules','ghost')}</div></div></section></div>`;}
const STEPS=[['Join as a cadet','Try the two-code joining flow. All names and codes are fictional.'],['Open a secret','Hold the envelope button to reveal your role, then hide it.'],['Put phones away','Cadets get a brief mission card and return to their team.'],['Receive an instruction','Reveal the Traitor envelope to see an NCO objective and the private circle.'],['Cast a private vote','Select a player. The local acknowledgement is deliberately labelled as simulated.'],['Review as an NCO','Submission status is visible without showing a running tally.'],['A reveal for the room','Open the public display to see a published murder. No pending target is sent to it.'],['Stay part of the team','An eliminated cadet still sees missions and scores, with no secret actions.'],['Reveal the winners','Each circle has a deduction winner. Mission points are awarded separately.']];
function guideBar(){const step=STEPS[guide];return `<div class="guidebar"><span class="step">${guide+1}</span><div class="grow"><h3>${step[0]}</h3><p>${step[1]}</p></div><div class="btns">${action('guide-restart','Restart','small ghost')}${action('guide-exit','Leave','small ghost')}${action('guide-next',guide===8?'Finish tour ✓':'Next →','small gold')}</div></div>`;}
function render(){if(view==='welcome')$('app').innerHTML=(guide>=0?`<div style="padding:15px;background:#22251b">${guideBar()}</div>`:'')+welcome();else $('app').innerHTML=shell(view==='cadet'?cadet():({overview,groups,missions,voting,night,schedule,results,log:logs,settings}[page]??overview)());bindHold();}
function confirm(title,text,fn,label='Confirm'){const d=$('modal');d.innerHTML=`<h2>${esc(title)}</h2><p>${esc(text)}</p><div class="btns"><button id="cancel-modal">Cancel</button><button class="gold" id="confirm-modal">${esc(label)}</button></div>`;d.showModal();$('cancel-modal').onclick=()=>d.close();$('confirm-modal').onclick=()=>{d.close();run(fn);};}
function show(title,html){const d=$('modal');d.innerHTML=`<h2>${esc(title)}</h2>${html}<div class="btns"><button id="cancel-modal">Close</button></div>`;d.showModal();$('cancel-modal').onclick=()=>d.close();}
function run(fn){try{fn();save();render();}catch(e){toast(e.message);}}
function setPhase(i){E.requireThat(i>=0&&i<s.phases.length,'Invalid phase.');if(s.phase===5&&i>5){for(const g of s.groups){const m=s.murders[E.murderKey(g.id,1)];if(m&&!m.confirmed){E.confirmMurder(s,g.id,1,false);}}}s.phase=i;s.remaining=phase().mins*60;s.running=false;s.deadline=null;E.record(s,`Host moved to ${phase().name}.`);}
function simulateVotes(){E.requireThat(phase().type==='vote','Advance to a round table and open voting first.');const gs=view==='nco'?[s.groups[group]]:s.groups;let count=0;gs.forEach(g=>{if(g.done)return;let v=s.votes[E.voteKey(s,g.id)];if(!v){E.openVote(s,g.id);v=s.votes[E.voteKey(s,g.id)];}if(v.status!=='open')return;E.active(s,g.id).forEach(p=>{if(!p.connected)return;const targets=E.active(s,g.id).filter(t=>t.id!==p.id&&(!v.candidates||v.candidates.includes(t.id)));if(targets.length){E.castVote(s,g.id,p.id,E.shuffle(targets)[0].id);count++;}});});E.record(s,`${count} fictional votes simulated.`);toast(`${count} simulated votes saved on this device.`);}
function simulateMurder(){E.requireThat(s.assigned,'Assign roles first.');E.requireThat(phase().slot!==undefined,'Advance to a murder opportunity or The Vault.');const slot=phase().slot;let count=0;s.groups.forEach(g=>{const t=E.active(s,g.id).filter(p=>p.role==='Traitor'),f=E.active(s,g.id).filter(p=>p.role==='Faithful');if(t.length&&f.length&&!s.murders[E.murderKey(g.id,slot)]?.confirmed){const target=E.shuffle(f)[0];t.forEach(p=>E.propose(s,g.id,slot,p.id,target.id));count++;}});E.record(s,`Simulated murder proposals for ${count} groups; nothing published.`);toast('Choices simulated. Review them in Night operations.');}
function selectView(val){roleVisible=false;privateRoles=false;if(val==='host'){view='host';page='overview';return;}if(val==='nco'){view='nco';page='groups';return;}const candidates=s.players.filter(p=>val==='eliminated'?p.status!=='Active':p.status==='Active'&&(val==='traitor'?p.role==='Traitor':p.role!=='Traitor'));E.requireThat(candidates.length,val==='traitor'?'Assign roles before previewing a Traitor.':'No eliminated players yet. Publish an elimination or use the guided demo.');playerId=candidates[0].id;group=candidates[0].group;view='cadet';}
function message(text){const p=person();E.requireThat(p.status==='Active'&&p.role==='Traitor'&&p.connected,'Secret actions are only available to connected, active Traitors.');s.messages.push({group:p.group,from:p.name,text,time:new Date().toLocaleTimeString('en-GB')});}
function guideStep(n){guide=n;roleVisible=false;privateRoles=false;if(n===0){view='welcome';return;}if(!s.assigned)E.assign(s);const f=s.players.find(p=>p.role==='Faithful'&&p.status==='Active')??s.players.find(p=>p.role==='Faithful'),t=s.players.find(p=>p.role==='Traitor'&&p.status==='Active');group=f.group;if(n===1){setPhase(1);view='cadet';playerId=f.id;}if(n===2){setPhase(2);view='cadet';playerId=f.id;}if(n===3){E.requireThat(t,'Reset the demo to restore an active Traitor.');setPhase(5);view='cadet';playerId=t.id;group=t.group;s.objectives[t.group]='Persuade your assigned target to say “trust no one” during The Vault. Your NCO must confirm success.';const target=E.active(s,t.group).find(p=>p.role==='Faithful');if(!s.murders[E.murderKey(t.group,1)])E.propose(s,t.group,1,t.id,target.id);}if(n===4){setPhase(3);view='cadet';playerId=f.id;if(!s.votes[E.voteKey(s,group)])E.openVote(s,group);}if(n===5){setPhase(3);view='nco';page='voting';simulateVotes();}if(n===6){setPhase(4);view='host';page='night';const actor=E.active(s,group).find(p=>p.role==='Traitor');let m=s.murders[E.murderKey(group,0)];if(!m){E.propose(s,group,0,actor.id,E.active(s,group).find(p=>p.role==='Faithful').id);m=s.murders[E.murderKey(group,0)];}if(!m.confirmed)E.confirmMurder(s,group,0);if(!m.published)E.publishMurder(s,group,0);}if(n===7){setPhase(8);view='cadet';playerId=s.players.find(p=>p.status!=='Active').id;}if(n===8){setPhase(10);view='host';page='results';for(const [key,m]of Object.entries(s.murders)){if(m.confirmed&&!m.published){const [slot,g]=key.split(':').map(Number);E.publishMurder(s,g,slot);}}E.finish(s);}E.record(s,`Guided demonstration: step ${n+1}.`);}
function bindHold(){const b=$('hold-role');if(!b)return;const stop=()=>{clearTimeout(holdTimer);holdTimer=null;};const start=()=>{stop();holdTimer=setTimeout(()=>{roleVisible=true;render();},700);};b.addEventListener('pointerdown',e=>{e.preventDefault();b.setPointerCapture(e.pointerId);start();});b.addEventListener('pointerup',stop);b.addEventListener('pointercancel',stop);b.addEventListener('pointerleave',stop);b.addEventListener('keydown',e=>{if([' ','Enter'].includes(e.key)&&!e.repeat){e.preventDefault();start();}});b.addEventListener('keyup',stop);b.addEventListener('blur',stop);}
document.addEventListener('visibilitychange',()=>{if(document.hidden){clearTimeout(holdTimer);roleVisible=false;privateRoles=false;if(view==='cadet')render();}});
document.addEventListener('change',e=>{if(e.target.id==='view-switch')run(()=>selectView(e.target.value));});
document.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(!b||b.disabled)return;const a=b.dataset.action;run(()=>{switch(a){
case 'start':view='host';page='overview';break;
case 'welcome':view='welcome';roleVisible=false;break;
case 'page':page=b.dataset.page;roleVisible=false;privateRoles=false;break;
case 'group':group=Number(b.dataset.group);page='groups';break;
case 'select-group':group=Number(b.dataset.group);privateRoles=false;break;
case 'nco':view='nco';page='groups';break;
case 'roles':privateRoles=!privateRoles;break;
case 'projector':save();window.open('projector.html','tno-projector');break;
case 'timer':if(s.running){s.remaining=Math.max(0,Math.ceil((s.deadline-Date.now())/1000));s.running=false;s.deadline=null;}else{s.deadline=Date.now()+s.remaining*1000;s.running=true;}E.record(s,`Timer ${s.running?'started':'paused'} in ${phase().name}.`);break;
case 'extend':s.remaining+=60;if(s.running)s.deadline+=60000;E.record(s,'Timer extended by one minute.');break;
case 'advance':confirm('Advance the evening?',`Move to ${s.phases[s.phase+1]?.name}. Unconfirmed secret attempts expire as failures when leaving The Vault. No result will be published automatically.`,()=>setPhase(s.phase+1),'Advance phase');break;
case 'jump':confirm('Move to this phase?',`Set the demo to ${s.phases[Number(b.dataset.index)].name}. The timer will be paused. Leaving The Vault expires unresolved secret attempts.`,()=>setPhase(Number(b.dataset.index)));break;
case 'assign':confirm('Close joining and assign roles?',`Assign ${s.settings.traitors} Traitors per group and release private envelopes. Roles will persist on this device.`,()=>E.assign(s),'Assign & release');break;
case 'sim-votes':simulateVotes();break;
case 'sim-murder':simulateMurder();break;
case 'disconnect':{const p=E.shuffle(s.players.filter(p=>p.connected))[0];E.requireThat(p,'Everyone is already disconnected.');p.connected=false;E.record(s,`${p.name} simulated signal loss. Not eliminated.`);toast(`${p.name} disconnected. Restore access from Groups & players.`);break;}
case 'help':{const p=person();if(!s.helps.some(h=>h.id===p.id&&!h.done))s.helps.push({id:p.id,done:false});E.record(s,`${p.name} requested help.`);toast('Demo help request saved. The group NCO can acknowledge it.');break;}
case 'help-done':s.helps.filter(h=>h.id===Number(b.dataset.id)).forEach(h=>h.done=true);E.record(s,`${E.getPlayer(s,b.dataset.id).name}: help request acknowledged.`);break;
case 'open-vote':E.openVote(s,group);break;
case 'close-vote':confirm('Close this group’s ballot?','Unsubmitted votes will be recorded as abstentions. The result stays private until the host releases it.',()=>E.closeVote(s,group),'Close ballot');break;
case 'runoff':E.runoff(s,group);s.remaining=60;if(s.running)s.deadline=Date.now()+60000;break;
case 'random-tie':confirm('Draw between tied candidates?','This follows one tied runoff. The randomly selected candidate will be recorded in the event log.',()=>E.randomTie(s,group),'Run random draw');break;
case 'publish-banish':confirm('Publish this banishment?','Everyone will see the player’s name first. You can reveal their role separately. Public information cannot become secret again.',()=>E.publishBanish(s,group),'Publish name');break;
case 'reveal-role':confirm('Reveal the banished player’s role?','This makes their identity public and cannot meaningfully be undone.',()=>E.revealRole(s),'Reveal role');break;
case 'confirm-murder':confirm('Confirm the private outcome?','Confirm physical success if applicable. Eligibility and shields are checked in this demo engine. The victim stays off the public display until publication.',()=>E.confirmMurder(s,group,phase().slot??0),'Confirm privately');break;
case 'fail-murder':E.confirmMurder(s,group,phase().slot??0,false);break;
case 'publish-murder':confirm('Release the night’s outcome?','This publishes the confirmed outcome and updates player status. Only one victim is allowed for this opportunity.',()=>E.publishMurder(s,group,phase().slot??0),'Publish reveal');break;
case 'hide-role':roleVisible=false;break;
case 'cadet-vote':{const p=person();E.requireThat(p.connected,'Simulated signal loss. Ask your NCO to restore access.');E.castVote(s,p.group,p.id,Number(b.dataset.id));toast('Vote saved locally. You can change it until voting closes.');break;}
case 'preset':message(b.dataset.text);break;
case 'report-objective':message('I report the objective completed. Awaiting NCO verification.');E.record(s,`${person().name} reported secret objective completion; not yet confirmed.`);break;
case 'rules':show('A quick reminder',`<p>Work with your group on physical missions. During a round table, vote for an active player in your own group. You cannot vote for yourself.</p><p>Keep accusations about game actions. Eliminated players still help with missions and scores, but cannot vote or use private Traitor actions. Tell your NCO if you need help.</p>`);break;
case 'mission-detail':{const m=s.missions[Number(b.dataset.index)];show(m.title,`<p>${esc(m.instructions)}</p><div class="notice">Up to ${m.points} points. Physical completion must be confirmed by the NCO.</div>`);break;}
case 'mission-edit':{const i=Number(b.dataset.index),m=s.missions[i];show('Edit mission card',`<form id="mission-form" data-index="${i}" class="stack"><label class="field">Title<input id="mission-title" value="${esc(m.title)}" maxlength="60" required></label><label class="field">Summary<textarea id="mission-description" required>${esc(m.description)}</textarea></label><label class="field">Instructions<textarea id="mission-instructions" required>${esc(m.instructions)}</textarea></label><label class="field">Maximum points<input id="mission-points" type="number" min="0" max="1000" value="${m.points}" required></label><button class="gold" type="submit">Save mission</button></form>`);break;}
case 'player-tools':{const p=E.getPlayer(s,b.dataset.id);show(`Manage ${p.name}`,`<form id="player-form" data-id="${p.id}" class="stack"><label class="field">Optional callsign<input id="callsign" value="${esc(p.callsign??'')}" maxlength="24" placeholder="No personal names required"></label><label class="field">Player status<select id="player-status">${['Active','Banished','Murdered'].map(t=>`<option ${t===p.status?'selected':''}>${t}</option>`).join('')}</select></label><label class="check"><input type="checkbox" id="player-connected" ${p.connected?'checked':''}>Restore / retain simulated connection</label><label class="check"><input type="checkbox" id="player-shield" ${p.shield?'checked':''} ${s.settings.shields?'':'disabled'}>Shield (${s.settings.shields?'enabled':'disabled in settings'})</label><label class="field">Reason for manual change<input id="correction-reason" required maxlength="180" placeholder="Explain the correction or access recovery"></label><div class="notice">A publicly revealed identity cannot become secret again. Status corrections do not remove published history.</div><button class="gold" type="submit">Review change</button></form>`);break;}
case 'late':{const i=s.phases.findIndex((p,i)=>i>=s.phase&&p.type==='mission'&&p.mins>5);E.requireThat(i>=0,'No remaining mission can be shortened. Keep the finale and clear up protected.');confirm('Recover five minutes?',`Shorten ${s.phases[i].name} by five minutes. Finale, clear up and parade stay unchanged. This is a suggested time saving, not automatic rescheduling.`,()=>{s.phases[i].mins-=5;if(i===s.phase){s.remaining=Math.max(0,s.remaining-300);if(s.running)s.deadline=Date.now()+s.remaining*1000;}E.record(s,`Running late: shortened ${s.phases[i].name} by five minutes.`);},'Shorten mission');break;}
case 'finish':confirm('End the game and reveal every role?','Any remaining Traitor wins their group. Confirmed murder outcomes must be published first. This releases all roles publicly.',()=>E.finish(s),'Reveal winners');break;
case 'reset':confirm('Start a fresh rehearsal?','This clears progress, roles, votes, scores and the organiser log on this device.',()=>{s=E.initial();guide=-1;view='host';page='overview';group=0;playerId=1;roleVisible=false;},'Reset demo');break;
case 'delete':confirm('Delete this demo’s stored game data?','Removes the local game and public snapshot from this browser. Reloading will offer a fresh fictional demo.',()=>{localStorage.removeItem(KEY);localStorage.removeItem(PUB);s=E.initial();guide=-1;view='welcome';render();setTimeout(()=>{localStorage.removeItem(KEY);localStorage.removeItem(PUB);},0);},'Delete data');break;
case 'guide':case 'guide-restart':confirm('Start the staff walkthrough?','The guided tour uses a fresh simulated event and replaces current rehearsal progress. It demonstrates role assignment, a murder publication and the final reveal.',()=>{s=E.initial();group=0;guideStep(0);},'Start walkthrough');break;
case 'guide-next':if(guide===8){guide=-1;toast('Walkthrough complete. Reset for a full rehearsal.');}else guideStep(guide+1);break;
case 'guide-exit':guide=-1;break;
}});});
document.addEventListener('submit',e=>{e.preventDefault();const f=e.target;run(()=>{switch(f.id){
case 'join-form':{E.requireThat(s.joining,'Joining is closed. Ask the organiser to use a preview or reset the demo.');E.requireThat($('event-code').value.trim().toUpperCase()==='2427-DEMO','Use event code 2427-DEMO for this local demo.');const match=$('join-code').value.trim().toUpperCase().match(/^P(\d{2})-DEMO$/),p=match&&E.getPlayer(s,Number(match[1]));E.requireThat(p,'Use the individual fictional code P01-DEMO to P'+String(s.players.length).padStart(2,'0')+'-DEMO.');playerId=p.id;group=p.group;view='cadet';E.record(s,`${p.name} tried the simulated joining flow.`);break;}
case 'announce-form':{const text=$('announcement').value.trim();E.requireThat(text,'Enter an announcement.');s.announcements.unshift({text,time:new Date().toLocaleTimeString('en-GB')});E.record(s,'Host published an announcement.');toast('Announcement published to the local demo.');break;}
case 'score-form':{const delta=Number($('score-delta').value),reason=$('score-reason').value.trim();E.requireThat(Number.isFinite(delta)&&reason,'Enter points and a reason.');s.groups[group].score+=delta;E.record(s,`${s.groups[group].name}: ${delta>=0?'+':''}${delta} mission points. ${reason}`);break;}
case 'proxy-form':E.castVote(s,group,Number($('proxy-voter').value),Number($('proxy-target').value),true);toast('Proxy vote saved locally and logged.');break;
case 'murder-form':E.propose(s,group,phase().slot??0,Number($('murder-actor').value),Number($('murder-target').value));E.record(s,`${s.groups[group].name}: NCO recorded a murder proposal.`);break;
case 'objective-form':s.objectives[group]=$('objective').value.trim();E.record(s,`${s.groups[group].name}: NCO sent a private objective.`);toast('Objective saved to the active Traitor view.');break;
case 'cadet-target-form':{const p=person();E.requireThat(p.connected,'Restore your connection first.');E.propose(s,p.group,phase().slot??0,p.id,Number($('cadet-target').value));toast('Target choice saved locally; NCO confirmation required.');break;}
case 'chat-form':message($('chat-text').value.trim());break;
case 'mission-form':{const i=Number(f.dataset.index);s.missions[i]={title:$('mission-title').value.trim(),description:$('mission-description').value.trim(),instructions:$('mission-instructions').value.trim(),points:Number($('mission-points').value)};s.phases[[2,5,8][i]].name=s.missions[i].title;E.record(s,`Mission ${i+1} edited.`);$('modal').close();break;}
case 'schedule-form':{const next=s.phases.map((p,i)=>({...p,time:$('start-'+i).value,mins:Number($('mins-'+i).value)}));E.requireThat(next.every((p,i)=>!i||p.time>next[i-1].time),'Start times must increase through the evening.');s.phases=next;if(!s.running)s.remaining=phase().mins*60;E.record(s,'Host edited the event timetable.');toast('Timetable saved. Check finale and clear up times before the event.');break;}
case 'settings-form':{if(!s.assigned){const groups=Number($('group-count').value),size=Number($('group-size').value),traitors=Number($('traitor-count').value);E.requireThat(traitors<size,'Keep at least one Faithful per group.');s.settings={...s.settings,groups,size,traitors};s.groups=E.GROUPS.slice(0,groups).map((name,id)=>({...s.groups[id],id,name,score:s.groups[id]?.score??0,done:false}));s.players=Array.from({length:groups*size},(_,i)=>({id:i+1,name:`Player ${String(i+1).padStart(2,'0')}`,group:Math.floor(i/size),role:null,status:'Active',connected:true,shield:false}));group=Math.min(group,groups-1);}s.settings.shields=$('shields').checked;s.settings.chat=$('chat').checked;s.settings.decisionMaker=$('decision-maker').checked;s.settings.sound=$('sound').checked;E.record(s,'Host updated event settings.');toast('Settings saved.');break;}
case 'player-form':{const p=E.getPlayer(s,f.dataset.id),status=$('player-status').value,connected=$('player-connected').checked,shield=$('player-shield').checked,callsign=$('callsign').value.trim(),reason=$('correction-reason').value.trim();$('modal').close();confirm('Apply the player correction?',`${p.name}: ${status}. ${reason} Any previously public role remains known.`,()=>{p.status=status;p.connected=connected;p.shield=shield;p.callsign=callsign;p.name=`Player ${String(p.id).padStart(2,'0')}${callsign?' · '+callsign:''}`;s.groups[p.group].done=false;E.checkGroup(s,p.group);E.record(s,`${p.name}: manual correction (${status}, ${connected?'connected':'disconnected'}). Reason: ${reason}`);});break;}
}});});
setInterval(()=>{if(!s.running)return;s.remaining=Math.max(0,Math.ceil((s.deadline-Date.now())/1000));document.querySelectorAll('[data-timer]').forEach(n=>n.textContent=time(s.remaining));if(s.remaining===0){s.running=false;s.deadline=null;E.record(s,`Timer ended: ${phase().name}. Awaiting organiser action.`);toast('Time is up. The organiser decides what happens next.');if(s.settings.sound){try{const c=new AudioContext(),o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);g.gain.value=.08;o.frequency.value=440;o.start();o.stop(c.currentTime+.3);o.onended=()=>c.close();}catch{}}save();render();}else save();},1000);
save();render();
